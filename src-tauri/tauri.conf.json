{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dockl Dev",
  "version": "../package.json",
  "identifier": "dev.dockl.desktop.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Dockl",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "tray-menu",
        "create": false,
        "url": "/tray-menu",
        "width": 260,
        "height": 320,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:14200",
        "connect-src": "ipc: http://ipc.localhost http://localhost:14200 ws://localhost:14200",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
