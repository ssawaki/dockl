{
  "name": "dockl",
  "version": "0.1.3",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "app": "tauri dev",
    "installer": "tauri build --config src-tauri/tauri.release.conf.json",
    "build": "node scripts/build-without-dev-routes.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:all": "lefthook run check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "lefthook install && git config --local blame.ignoreRevsFile .git-blame-ignore-revs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@fluentui/svg-icons": "^1.1.334",
    "@fluentui/tokens": "^1.0.0-alpha.23",
    "@fluentui/web-components": "^3.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.3"
  }
}
